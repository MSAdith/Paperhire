PORT=5000

# --- Sign-in, analytics and admin (required) ---
# Every feature needs a signed-in user. Without SUPABASE_URL and
# SUPABASE_SERVICE_ROLE_KEY, feature endpoints return 503 (never open access).
# All three values: Supabase dashboard -> Project Settings -> API.
# SUPABASE_URL=https://your-project-ref.supabase.co
#
# Public key used by the browser (fetched from /api/config at runtime).
# SUPABASE_ANON_KEY=your_supabase_anon_key
#
# SERVER ONLY. Bypasses row-level security: never put it in client code, a
# VITE_ variable, or anything the browser can see.
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
#
# Comma-separated emails allowed into /admin (checked on the server).
# ADMIN_EMAILS=you@example.com,cofounder@example.com

# --- AI features (optional) ---
# Enables AI bullet rewrites on the ATS report and the Tailor Resume, Cover Letter,
# Interview Prep, and Skill-Gap learning-plan features. The ATS scorer works without it.
#
# AI_PROVIDER picks who runs the model: "cometapi" (default), "gemini", or "anthropic".
# Only the key for the selected provider is needed.
AI_PROVIDER=cometapi

# Model ID for the selected provider. Leave unset to use the provider default:
#   cometapi  -> gemini-3.6-flash   (see https://api.cometapi.com/api/models for IDs)
#   gemini    -> gemini-3.6-flash   (free-tier Flash model, see https://aistudio.google.com/docs/models)
#   anthropic -> claude-sonnet-5-5
# AI_MODEL=gemini-3.6-flash

# CometAPI (OpenAI-compatible). Get a key at https://www.cometapi.com/console/token
# COMETAPI_KEY=your_cometapi_key_here

# Google Gemini API (has a free tier). Get a key at https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic. Get a key at https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Job search (optional) ---
# RapidAPI key subscribed to the JSearch API. Enables the Job Matches tab.
# Free tier is roughly 200 requests/month; identical searches are cached for ~1 hour.
# Get one at https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# JSEARCH_API_KEY=your_rapidapi_key_here
